root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,html,css,js,md,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 读 UTF-8 无 BOM 文件时会按 ANSI 解析，
# 所以 .ps1 必须保持 UTF-8 with BOM + CRLF。
[*.ps1]
end_of_line = crlf
charset = utf-8-bom

[*.sh]
end_of_line = lf

[Makefile]
indent_style = tab
